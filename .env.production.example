# Copy to .env.production and fill in. Never commit the real file.

# Your domain, e.g. sales.gva.rw — must point (DNS A record) to the server's IP. Used by Caddy for HTTPS.
DOMAIN=sales.example.com

# Long random secret: run   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email for sign-in codes (required in production)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GVA Sales Pipeline <no-reply@example.com>"

# First start only: the admin account to create. Remove the password after the first sign-in.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Server time zone (reminders, daily backup hour, "today" in reports)
TZ=Africa/Kigali
